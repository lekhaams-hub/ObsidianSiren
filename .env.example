# Frontend Environment Variables
# Rename this file to .env and add your real keys.
# Do NOT commit a .env file with real credentials.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# API URL for backend
VITE_API_URL=http://localhost:5000

# Add your Gemini API key here for Ask Obsidian AI.
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-1.5-pro

# ============================================
# Backend Environment Variables (server.js)
# Create a .env file with these variables:
# ============================================

# Gmail credentials for sending consultation emails
# Use an App Password, NOT your regular Gmail password
# See: https://support.google.com/accounts/answer/185833
GMAIL_USER=your-gmail-id
GMAIL_APP_PASSWORD=your-gmail-app-password

# Email recipient for consultation submissions
# Default: 71762305054@cit.edu.in
EMAIL_RECIPIENT=default-email

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Server port (optional, defaults to 5000)
PORT=5000